name: 每日早报

on:
  schedule:
    # 北京时间凌晨 5:00 (UTC 21:00)，预留 1-2 小时排队延迟，约 6:00-7:00 到达
    - cron: "0 21 * * *"
  # 允许手动触发测试
  workflow_dispatch:

jobs:
  send-news:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: 检出代码
        uses: actions/checkout@v5

      - name: 设置 Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"

      - name: 安装依赖
        run: pip install -r requirements.txt

      - name: DNS 连通性检查
        run: |
          echo "=== DNS 解析测试 ==="
          python3 -c "import socket; print('smtp.163.com →', socket.getaddrinfo('smtp.163.com', 465))"

      - name: 运行每日早报
        env:
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          DEEPSEEK_BASE_URL: ${{ secrets.DEEPSEEK_BASE_URL || 'https://api.deepseek.com/v1' }}
          DEEPSEEK_MODEL: ${{ secrets.DEEPSEEK_MODEL || 'deepseek-v4-flash' }}
          EMAIL_FROM: ${{ secrets.EMAIL_FROM }}
          EMAIL_TO: ${{ secrets.EMAIL_TO }}
          EMAIL_PASSWORD: ${{ secrets.EMAIL_PASSWORD }}
          EMAIL_SMTP_SERVER: smtp.163.com
          EMAIL_SMTP_PORT: "465"
        run: python main.py
