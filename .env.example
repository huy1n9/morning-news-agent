# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 163 邮箱配置
# ⚠️ 注意：不是登录密码！需要在 163 邮箱设置中开启 SMTP 服务获取"授权码"
# 获取方式：登录 mail.163.com → 设置 → POP3/SMTP/IMAP → 开启 SMTP → 获取授权码
EMAIL_FROM=your_email@163.com
EMAIL_TO=your_email@163.com
EMAIL_PASSWORD=your-smtp-auth-code
EMAIL_SMTP_SERVER=smtp.163.com
EMAIL_SMTP_PORT=465

# 代理配置（可选，用于访问 Google News、BBC 等国际新闻源）
# 格式：http://host:port 或 socks5://host:port
# HTTPS_PROXY=http://127.0.0.1:7890

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
